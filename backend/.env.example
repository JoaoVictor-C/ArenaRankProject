# arenarank backend — example environment.
# Copy to `.env` for local (non-docker) runs: `cp .env.example .env`.
# docker-compose injects these directly (see docker-compose.yml `environment:`),
# so you only need a local `.env` when running uvicorn/arq outside compose.
#
# NOTE: every var maps 1:1 to a field on arena.core.config.Settings.

# --- Service identity -------------------------------------------------------
SERVICE_NAME=arenarank-api
ENVIRONMENT=development

# --- Datastores -------------------------------------------------------------
# Async SQLAlchemy DSN (asyncpg driver). For local-without-docker use localhost.
# Inside docker-compose the host is the `postgres` service (see compose env).
#
# Web (API) connects via PgBouncer TRANSACTION pool on 6432.
# Workers connect via PgBouncer SESSION pool on 6433 (set in the worker service).
# Alembic migrations should target the DIRECT postgres endpoint (5432) so
# TimescaleDB policy / DDL statements are not broken by transaction pooling.
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5432/arena

# Redis — cache, per-player locks, arq queues, Riot token-bucket (Lua).
REDIS_URL=redis://localhost:6379/0

# --- External integrations --------------------------------------------------
# Riot Games API key. Empty in dev (ingestion is a no-op without it).
RIOT_API_KEY=

# --- Admin / operator auth --------------------------------------------------
# Shared key gating every /admin/* + tournament-admin endpoint. The API sends it
# back as 503 ("not configured") until this is set, so set it to any non-empty
# value for local admin access. Clients send `X-Admin-Key: <value>`.
ADMIN_API_KEY=

# --- HTTP / CORS ------------------------------------------------------------
# CORS é fixo em "*" sem credenciais (T1.1 — exigência do edge cache da
# Cloudflare, que ignora Vary). Não há mais allowlist configurável.

# --- Read path (réplica) ----------------------------------------------------
# Ligar SOMENTE no EC2 (réplica): /healthz expõe o lag da replicação lógica e
# /meta/last-update + updatedAt refletem o instante real do último sync.
REPLICA_LAG_CHECK=false
# TTLs (s) do cache de resposta + s-maxage de edge, por rota (0 desliga):
# CACHE_TTL_LEADERBOARD_S=60  CACHE_TTL_CHAMPIONS_S=300  CACHE_TTL_META_S=300
# CACHE_TTL_PLAYERS_SEARCH_S=30  CACHE_TTL_MATCH_S=3600  CACHE_TTL_PLAYER_S=60
# CACHE_TTL_TOURNAMENTS_S=300

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
# OTLP collector endpoint, e.g. http://localhost:4317. Unset => telemetry no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_ENABLED=false
