# ArenaRank Admin Console — environment (all optional; everything also has a
# runtime switcher in the UI top bar).

# Default URL for the "Produção" backend preset (the in-app switcher can change
# it at runtime; this only seeds the default). Leave blank to fill it in the UI.
VITE_PROD_API_URL=

# Override the local dev-proxy target used by the "Local" preset.
# Defaults to http://localhost:8000 (the FastAPI read-API).
VITE_LOCAL_API_TARGET=http://localhost:8000
