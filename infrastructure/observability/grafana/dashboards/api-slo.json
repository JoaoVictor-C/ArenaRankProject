{
  "uid": "arenarank-api-slo",
  "title": "arenarank — API & SLO",
  "tags": ["arenarank", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job:http_requests:rate2m", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio (2m) — SLO < 1%",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job:http_5xx_ratio:2m" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 0.01, "color": "red" }] }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency p95",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job:http_request_duration:p95", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API pods (HPA scale)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "kube_deployment_status_replicas{namespace=\"api\",deployment=\"api\"}", "legendFormat": "current" },
        { "expr": "kube_deployment_spec_replicas{namespace=\"api\",deployment=\"api\"}", "legendFormat": "desired" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Leaderboard update latency + staleness",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(crs_leaderboard_update_latency_seconds_bucket[5m])))", "legendFormat": "update p95" },
        { "expr": "time() - max(crs_leaderboard_last_refresh_timestamp_seconds)", "legendFormat": "staleness (s)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Business — registered players / active-season players",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "crs_players_registered_total", "legendFormat": "registered" },
        { "expr": "crs_active_season_player_count", "legendFormat": "active season" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Datastore — Postgres replication lag / Redis memory %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_replication_lag_seconds", "legendFormat": "pg repl lag (s)" },
        { "expr": "redis_memory_used_bytes / clamp_min(redis_memory_max_bytes,1)", "legendFormat": "redis mem %" }
      ]
    }
  ]
}
