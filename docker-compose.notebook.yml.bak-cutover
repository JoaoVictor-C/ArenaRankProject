# arenarank — NOTEBOOK production stack (Celeron N4020 / 8GB RAM / 232GB SSD).
#
# Migrado do EC2 t3.micro (908MB). Diferenças vs docker-compose.prod-ec2.yml:
#   + postgres local (postgres:18, mesmo major da RDS de origem) — RDS desativada
#   + redis maxmemory 512mb (antes 128mb; box tem 8GB)
#   + api publica :8000 no host (rede local; exposição pública via túnel depois)
#   - sem caddy por enquanto (entra junto com cloudflared/exposição)
#
# Bring up:  docker compose -f docker-compose.notebook.yml up -d --build
# Restore:   ver instruções da migração (pg_restore do arena-migracao.dump)

name: arenarank-prod

services:
  postgres:
    image: postgres:18
    environment:
      POSTGRES_USER: arena
      POSTGRES_PASSWORD: CrsNb2026pg
      POSTGRES_DB: arena
    volumes:
      - pgdata:/var/lib/postgresql
    # shared_buffers modesto: divide a RAM com api+workers+redis
    ports:
      - "127.0.0.1:5432:5432"
    command: ["postgres", "-c", "shared_buffers=512MB", "-c", "effective_cache_size=2GB", "-c", "max_connections=60"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U arena -d arena"]
      interval: 10s
      timeout: 3s
      retries: 10
    restart: unless-stopped

  redis:
    image: redis:7
    # volatile-lru: cache descartável tem TTL, filas/locks não — evicta só cache.
    # NUNCA noeviction (rejeita escritas = pipeline morre). Lição do incidente OOM.
    command: ["redis-server", "--appendonly", "yes", "--maxmemory", "512mb", "--maxmemory-policy", "volatile-lru"]
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 10
    restart: unless-stopped

  api:
    build:
      context: ./backend
      dockerfile: Dockerfile
    command:
      ["uvicorn", "arena.api.app:app", "--host", "0.0.0.0", "--port", "8000",
       "--proxy-headers", "--forwarded-allow-ips", "*"]
    env_file: [.env]
    environment:
      SERVICE_NAME: arenarank-api
      REDIS_URL: redis://redis:6379/0
    ports:
      - "8000:8000"
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
    restart: unless-stopped

  worker-sweep:
    build:
      context: ./backend
      dockerfile: Dockerfile
    command: ["arq", "arena.workers.main.SweepWorker"]
    env_file: [.env]
    environment:
      SERVICE_NAME: arenarank-worker-sweep
      REDIS_URL: redis://redis:6379/0
      SWEEP_INTERVAL_MINUTES: "1"
      SWEEP_BATCH_SIZE: "40"
      SWEEP_MATCHES_PER_PLAYER: "10"
    healthcheck:
      disable: true
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
    restart: unless-stopped

  worker-bulk:
    build:
      context: ./backend
      dockerfile: Dockerfile
    command: ["arq", "arena.workers.main.BulkProcessorWorker"]
    env_file: [.env]
    environment:
      SERVICE_NAME: arenarank-worker-bulk
      REDIS_URL: redis://redis:6379/0
      BULK_PROCESSOR_INTERVAL_MINUTES: "1"
      BULK_BATCH_SIZE: "40"
      BULK_CONCURRENCY: "4"
      RIOT_MATCH_CACHE_TTL_SECONDS: "604800"
    healthcheck:
      disable: true
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
    restart: unless-stopped

  scheduler:
    build:
      context: ./backend
      dockerfile: Dockerfile
    command: ["arq", "arena.workers.main.SchedulerWorker"]
    env_file: [.env]
    environment:
      SERVICE_NAME: arenarank-scheduler
      REDIS_URL: redis://redis:6379/0
    healthcheck:
      disable: true
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
    restart: unless-stopped

volumes:
  pgdata:
  redisdata:
