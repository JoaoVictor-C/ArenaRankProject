# arenarank — root .env template (deployment / docker compose).
#
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Which compose file needs what:
#
#   docker-compose.yml              LOCAL. Needs almost nothing — every value
#                                   below has a working dev default baked into
#                                   the compose file. Set RIOT_API_KEY if you
#                                   want real ingestion.
#   docker-compose.prod.yml         Single-box prod. Needs the CORE block.
#   docker-compose.prod-ec2.yml     Public API only. Needs CORE minus
#                                   RIOT_API_KEY (this box never calls Riot).
#   docker-compose.prod-worker.yml  Workers. Needs CORE + the PGBOUNCER block.
#
# ── CORE ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# Riot API key. NOT needed by the EC2/API box — nothing under arena/api/ calls
# Riot. Required anywhere workers run.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Shared RDS. Use the DIRECT endpoint here: `migrate` runs off this value and
# DDL is not transaction-pool safe. The workers reach Postgres through their
# own local pgbouncer-session instead (see the PGBOUNCER block).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-instance.rds.amazonaws.com:5432/arena

# Operator key for the whole /admin/* surface. Fail-closed: empty means every
# admin request gets 503. Use a long random value, not a guessable one.
ADMIN_API_KEY=

# Browser origins allowed to call the API (comma-separated). The public site
# and, if you use it remotely, the admin console.
CORS_ORIGINS=https://arenarank.lol,https://www.arenarank.lol

# Launch-window cutoff: ignore any Arena match whose gameStartTimestamp is
# before this epoch-ms instant. 0 disables it. MUST be identical across every
# process — a mismatch makes one worker filter differently from another.
MATCH_MIN_STARTED_AT_MS=1784246400000

# SQLAlchemy pool, per process. Every API and worker container draws from the
# SAME RDS connection budget, so keep the sum under the instance's
# max_connections with headroom.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis maxmemory for the box. EC2/API defaults to 128mb (disposable read
# cache); the worker box defaults to 512mb (queues + match payloads).
# REDIS_MAXMEMORY=512mb

# ── TELEMETRIA DE WORKERS (split EC2 <-> notebook) ────────────────────────
# Onde as rotas de telemetria buscam fila/workers/uso da Riot.
#   redis (padrão) — o Redis deste processo. Correto onde a API divide o Redis
#                    com os workers: local e prod numa caixa só.
#   db             — a tabela worker_telemetry, publicada pela caixa de workers.
#                    É o que a API do EC2 usa: o Redis DELA não tem fila nem
#                    heartbeat, e responderia zeros com cara de verdade
#                    (medido: 0 contra 166 de profundidade real).
# Já vem fixo em docker-compose.prod-ec2.yml; só mexa aqui em topologia custom.
# WORKER_TELEMETRY_SOURCE=redis
# Idade a partir da qual o snapshot conta como obsoleto e a UI mostra
# "indisponível" com a idade, em vez do número velho.
# WORKER_TELEMETRY_STALE_AFTER_SECONDS=180

# ── PGBOUNCER (docker-compose.prod-worker.yml only) ───────────────────────
# The worker box fronts RDS with a local SESSION-mode pgbouncer: workers hold
# advisory locks and prepared state across statements, which transaction
# pooling breaks. These are the same RDS coordinates as DATABASE_URL, split
# into fields because pgbouncer's image takes them separately.
PGB_DB_HOST=your-instance.rds.amazonaws.com
PGB_DB_PORT=5432
PGB_DB_USER=USER
PGB_DB_PASSWORD=PASSWORD
PGB_DB_NAME=arena
# Cap this box's share of RDS connection slots — the API box needs some too.
PGB_POOL_SIZE=20
PGB_MAX_CLIENT_CONN=200

# ── SEASON REFILL ─────────────────────────────────────────────────────────
# Riot IDs ("Name#TAG", comma-separated) that seed discovery when the database
# is empty. Riot has no "all matches in region" endpoint — every match id is
# reached through a puuid we already know — so with no players and no seeds,
# discovery never starts.
#
# THESE BELONG ON THE WORKER BOX, not on EC2. Seeding resolves a Riot ID to a
# puuid (needs RIOT_API_KEY) and enqueues a history backfill (needs the QUEUES
# Redis); the EC2 API has neither. The admin route only records the request —
# the worker box's bootstrap_tick does the seeding on its next minute, and any
# failure comes back as `lastError` in GET /admin/ingest.
#
# Leave unset and the refill button will report, via lastError:
#   "Nenhuma semente configurada: defina BOOTSTRAP_SEED_RIOT_IDS ..."
BOOTSTRAP_SEED_RIOT_IDS=Presente#1001,CrazzyBoy#Br2
# BOOTSTRAP_SEED_REGION=americas

# ── TUNING (optional; sensible defaults live in the compose files) ────────
# SWEEP_INTERVAL_MINUTES=1
# SWEEP_BATCH_SIZE=40
# SWEEP_MATCHES_PER_PLAYER=10
# Match payloads (~135 KB) only need to survive fetch -> rate. Left unbounded
# they were the single largest Redis memory consumer.
# RIOT_MATCH_CACHE_TTL_SECONDS=600
# Local port for the worker box's admin-only API (bound to 127.0.0.1).
# ADMIN_API_PORT=8001
